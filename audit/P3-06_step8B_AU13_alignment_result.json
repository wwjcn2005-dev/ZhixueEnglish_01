  "segments": [
    {
      "start": 0.0,
      "end": 3.4,
      "text": "Reading for writing. Activity too."
    },
    {
      "start": 4.42,
      "end": 8.5,
      "text": "Read the passage and find out the meaning of the title."
    },
    {
      "start": 10.22,
      "end": 12.58,
      "text": "Before your journey starts"
    },
    {
      "start": 13.94,
      "end": 20.26,
      "text": "Mia, how do you feel about your first day in junior high tomorrow?"
    },
    {
      "start": 21.08,
      "end": 24.3,
      "text": "Well, I'm a little nervous."
    },
    {
      "start": 25.2,
      "end": 28.94,
      "text": "Don't worry, we've got something for you."
    },
    {
      "start": 28.94,
      "end": 32.4,
      "text": "Look, a paper boat?"
    },
    {
      "start": 33.38,
      "end": 38.3,
      "text": "Yes, and it's also a letter from mum and me."
    },
    {
      "start": 39.04,
      "end": 41.6,
      "text": "We want to share some thoughts with you."
    },
    {
      "start": 42.28,
      "end": 44.42,
      "text": "Oh, thank you."
    },
    {
      "start": 46.2,
      "end": 48.94,
      "text": "Dear Mia, time flies."
    },
    {
      "start": 50.22,
      "end": 54.64,
      "text": "You are now in junior high. Are you ready for your new life?"
    },
    {
      "start": 55.72,
      "end": 58.5,
      "text": "Primary school is like a small pool."
    },
    {
      "start": 59.44,
      "end": 64.58,
      "text": "Your boat is safe there. Dad and mum can protect it from winds."
    },
    {
      "start": 65.6,
      "end": 68.06,
      "text": "But junior high is like a river."
    },
    {
      "start": 69.06,
      "end": 72.3,
      "text": "It is wide and the water moves fast."
    },
    {
      "start": 73.4,
      "end": 75.24,
      "text": "You will face new problems."
    },
    {
      "start": 76.22,
      "end": 78.02,
      "text": "We are still here to help."
    },
    {
      "start": 78.68,
      "end": 82.52,
      "text": "But sometimes you have to sail your boat by yourself."
    },
    {
      "start": 82.52,
      "end": 86.32,
      "text": "Just try your best and work hard."
    },
    {
      "start": 87.26,
      "end": 90.14,
      "text": "You will go through storms towards the sea."
    },
    {
      "start": 91.5,
      "end": 94.42,
      "text": "We hope this letter helps you in the coming years."
    },
    {
      "start": 95.3,
      "end": 98.12,
      "text": "With love, dad and mum."
    }
  ],
