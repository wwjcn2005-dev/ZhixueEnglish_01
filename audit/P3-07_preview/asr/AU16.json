  "segments": [
    {
      "start_ms": 0,
      "end_ms": 10600,
      "text": "Developing ideas. Activity 1. Listen to the conversation. What does Wang Chen do?"
    },
    {
      "start_ms": 12480,
      "end_ms": 16880,
      "text": "Look, Wei Feng. There's a brown bird over there."
    },
    {
      "start_ms": 17680,
      "end_ms": 24420,
      "text": "Let's go closer. Oh no, it can't fly."
    },
    {
      "start_ms": 25420,
      "end_ms": 27300,
      "text": "Shall we get the teacher?"
    },
    {
      "start_ms": 29620,
      "end_ms": 38020,
      "text": "I have an idea. Wang Chen is in the bird watching club. Let's ask him."
    },
    {
      "start_ms": 38960,
      "end_ms": 41120,
      "text": "Wang Chen, help!"
    },
    {
      "start_ms": 42140,
      "end_ms": 43320,
      "text": "Let me see."
    },
    {
      "start_ms": 45120,
      "end_ms": 54040,
      "text": "Don't worry, I know this kind of bird. I can help. We just need to hold it up to the window."
    },
    {
      "start_ms": 54040,
      "end_ms": 58660,
      "text": "Wow! The bird flies away!"
    },
    {
      "start_ms": 59700,
      "end_ms": 71000,
      "text": "Wang Chen, you know so much about birds! I'm in the school news station. Can I interview you next week?"
    },
    {
      "start_ms": 71860,
      "end_ms": 72500,
      "text": "Sure!"
    }
  ],
