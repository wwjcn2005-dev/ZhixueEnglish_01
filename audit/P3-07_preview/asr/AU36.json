      "text": "Example conversation"
    },
    {
      "start_ms": 19180,
      "end_ms": 23680,
      "text": "Planting day is coming. Let's do something!"
    },
    {
      "start_ms": 23680,
      "end_ms": 34720,
      "text": "Sure. Plants mean a lot to us. They are homes to animals. They also give us food and clean air."
    },
    {
      "start_ms": 35460,
      "end_ms": 38740,
      "text": "So what are your plans for planting day?"
    },
    {
      "start_ms": 39420,
      "end_ms": 47060,
      "text": "I'm going to make a green corner. How about growing some flowers in our classroom?"
    },
    {
      "start_ms": 47900,
      "end_ms": 49120,
      "text": "Sounds great!"
    }
