  "duration_ms": 107624,
  "segment_count": 14,
  "word_count": 179,
  "segments": [
    {
      "start_ms": 0,
      "end_ms": 3500,
      "text": "Reading for writing, activity too."
    },
    {
      "start_ms": 4480,
      "end_ms": 8140,
      "text": "Read the story and check your answers."
    },
    {
      "start_ms": 10300,
      "end_ms": 12080,
      "text": "When duty shines"
    },
    {
      "start_ms": 14000,
      "end_ms": 21860,
      "text": "For Chinese people, festivals usually mean a break from work and happy family reunions."
    },
    {
      "start_ms": 22280,
      "end_ms": 27760,
      "text": "But for Leng Wenying, festivals only mean more work."
    },
    {
      "start_ms": 27760,
      "end_ms": 36980,
      "text": "As a doctor in the emergency room, Lung misses many family meals with her loved ones. She"
    },
    {
      "start_ms": 36980,
      "end_ms": 45600,
      "text": "is often much busier during festivals. Sometimes she has to work without any breaks for 20"
    },
    {
      "start_ms": 45600,
      "end_ms": 55320,
      "text": "hours. This makes her tired and thirsty. Festivals are a challenge because our patients are"
    },
    {
      "start_ms": 55320,
      "end_ms": 62200,
      "text": "often in a bad situation. We need to stand by every minute,\" says Lung."
    },
    {
      "start_ms": 63480,
      "end_ms": 70940,
      "text": "Lung's duty means she has little time to be with her family at festivals, but she never"
    },
    {
      "start_ms": 70940,
      "end_ms": 74400,
      "text": "regrets her decision to be an ER doctor."
    },
    {
      "start_ms": 75320,
      "end_ms": 84340,
      "text": "I make the most of every minute with my family. I'm very thankful for their support,\" she says."
    },
    {
      "start_ms": 85840,
      "end_ms": 95300,
      "text": "Lung is only one of millions of medical workers in China. They give up their family time to answer"
    },
    {
      "start_ms": 95300,
      "end_ms": 104120,
      "text": "the call of duty. In the heart of every patient, their hard work shines brighter than fireworks."
    }
  ],
