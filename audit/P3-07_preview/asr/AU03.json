      "text": "activity 10 listen and choose"
    },
    {
      "start_ms": 6100,
      "end_ms": 12060,
      "text": "Hi Wong Tao what are you going to wear tomorrow for school?"
    },
    {
      "start_ms": 12740,
      "end_ms": 15180,
      "text": "my school uniform of course"
    },
    {
      "start_ms": 16260,
      "end_ms": 22740,
      "text": "I'm going to wear a blue sports jacket and blue sports trousers"
    },
    {
      "start_ms": 23700,
      "end_ms": 24940,
      "text": "how about you?"
    },
    {
      "start_ms": 24940,
      "end_ms": 35500,
      "text": "I'm also going to wear my school uniform. I have a grey coat, a white shirt and a grey skirt."
    },
    {
      "start_ms": 36520,
      "end_ms": 38900,
      "text": "What shoes are you going to wear?"
    },
    {
      "start_ms": 39620,
      "end_ms": 44400,
      "text": "I'm going to wear a pair of black shoes. How about you?"
    },
    {
      "start_ms": 45440,
      "end_ms": 48220,
      "text": "I'll wear white sports shoes."
    },
    {
      "start_ms": 49000,
      "end_ms": 52180,
      "text": "Oh! Don't forget your red scarf."
    },
    {
      "start_ms": 52180,
      "end_ms": 55020,
      "text": "Thanks. I won't."
    }
  ],
