  "segments": [
    {
      "start_ms": 0,
      "end_ms": 1920,
      "text": "Developing ideas"
    },
    {
      "start_ms": 2800,
      "end_ms": 4240,
      "text": "Activity 1"
    },
    {
      "start_ms": 5340,
      "end_ms": 7680,
      "text": "Listen to the family hotline"
    },
    {
      "start_ms": 8540,
      "end_ms": 11780,
      "text": "What problem does Tina have with her mother?"
    },
    {
      "start_ms": 13280,
      "end_ms": 16060,
      "text": "We all know problem children"
    },
    {
      "start_ms": 16620,
      "end_ms": 19360,
      "text": "but do you know problem parents?"
    },
    {
      "start_ms": 20260,
      "end_ms": 25140,
      "text": "Children sometimes call me to talk about their problem parents"
    },
    {
      "start_ms": 25140,
      "end_ms": 30460,
      "text": "For example, Tina's mother is an actress at a park."
    },
    {
      "start_ms": 31340,
      "end_ms": 34200,
      "text": "Every day she dresses up as a queen."
    },
    {
      "start_ms": 35100,
      "end_ms": 35900,
      "text": "Cool, right?"
    },
    {
      "start_ms": 36700,
      "end_ms": 39220,
      "text": "But Tina doesn't think so."
    },
    {
      "start_ms": 40200,
      "end_ms": 43820,
      "text": "Her mother often goes to pick her up in this dress."
    },
    {
      "start_ms": 44560,
      "end_ms": 47460,
      "text": "Tina is not happy about this."
    },
    {
      "start_ms": 48560,
      "end_ms": 52960,
      "text": "My advice for her is have a good talk with her mother."
    }
  ],
