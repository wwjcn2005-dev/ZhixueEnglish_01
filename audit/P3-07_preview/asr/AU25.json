  "segments": [
    {
      "start_ms": 0,
      "end_ms": 1460,
      "text": "Activity 2"
    },
    {
      "start_ms": 2000,
      "end_ms": 5580,
      "text": "Listen again and complete the chart."
    },
    {
      "start_ms": 6620,
      "end_ms": 12720,
      "text": "We all know problem children, but do you know problem parents?"
    },
    {
      "start_ms": 13840,
      "end_ms": 18640,
      "text": "Children sometimes call me to talk about their problem parents."
    },
    {
      "start_ms": 19620,
      "end_ms": 23980,
      "text": "For example, Tina's mother is an actress at a park."
    },
    {
      "start_ms": 24800,
      "end_ms": 27740,
      "text": "Every day she dresses up as a queen."
    },
    {
      "start_ms": 27740,
      "end_ms": 37320,
      "text": "Cool, right? But Tina doesn't think so. Her mother often goes to pick her up in this dress."
    },
    {
      "start_ms": 38140,
      "end_ms": 46460,
      "text": "Tina is not happy about this. My advice for her is have a good talk with her mother."
    }
  ],
