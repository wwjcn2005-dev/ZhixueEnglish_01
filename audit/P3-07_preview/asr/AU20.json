  "filename": "20_Unit 2_Developing ideas _Reading for writing_2 Read the story. What is Emma's adventure.mp3",
  "duration_ms": 115435,
  "segment_count": 17,
  "word_count": 170,
  "segments": [
    {
      "start_ms": 0,
      "end_ms": 3620,
      "text": "Reading for writing. Activity to."
    },
    {
      "start_ms": 4680,
      "end_ms": 8920,
      "text": "Read the story. What is Emma's adventure?"
    },
    {
      "start_ms": 10840,
      "end_ms": 12000,
      "text": "Emma's adventure."
    },
    {
      "start_ms": 13620,
      "end_ms": 16520,
      "text": "Oliver is awake at midnight."
    },
    {
      "start_ms": 17720,
      "end_ms": 21260,
      "text": "Suddenly a door appears in the wall."
    },
    {
      "start_ms": 22280,
      "end_ms": 25400,
      "text": "Oliver's heart almost stops."
    },
    {
      "start_ms": 25400,
      "end_ms": 34020,
      "text": "He walks over and taps on the door. Emma shakes her head and stops writing."
    },
    {
      "start_ms": 35160,
      "end_ms": 43980,
      "text": "She is new at this school. There are no old classmates here. She feels a bit lonely."
    },
    {
      "start_ms": 45180,
      "end_ms": 53620,
      "text": "Emma likes writing magic stories. She wants to make friends and share the joy of writing."
    },
    {
      "start_ms": 53620,
      "end_ms": 59820,
      "text": "She looks around the library. An idea hits her."
    },
    {
      "start_ms": 60880,
      "end_ms": 69720,
      "text": "Hello! This is my notebook. Do you like the story? Please write more."
    },
    {
      "start_ms": 70960,
      "end_ms": 79860,
      "text": "Emma puts the notebook on a shelf and leaves. A week later Emma's notebook is still on the"
    },
    {
      "start_ms": 79860,
      "end_ms": 90520,
      "text": "shelf in the library. Nervously she opens it. Her eyes open wide. There are pages of new"
    },
    {
      "start_ms": 90520,
      "end_ms": 97000,
      "text": "writing by different people. And there is a note on the last page."
    },
    {
      "start_ms": 98660,
      "end_ms": 107260,
      "text": "How about starting a writing group? Let's meet here on Wednesday after lunch. It's"
    },
    {
      "start_ms": 107260,
      "end_ms": 109860,
      "text": "the best ending to my story."
    },
    {
      "start_ms": 110440,
      "end_ms": 111360,
      "text": "Thanks Emma."
    }
  ],
