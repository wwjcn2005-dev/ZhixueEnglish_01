  "segments": [
    {
      "start_ms": 0,
      "end_ms": 3380,
      "text": "Reading for writing. Activity to."
    },
    {
      "start_ms": 4320,
      "end_ms": 8500,
      "text": "Read the passage and find out the meaning of the title."
    },
    {
      "start_ms": 10220,
      "end_ms": 12580,
      "text": "Before your journey starts."
    },
    {
      "start_ms": 13960,
      "end_ms": 20260,
      "text": "Mia, how do you feel about your first day in junior high tomorrow?"
    },
    {
      "start_ms": 21080,
      "end_ms": 24300,
      "text": "Well, I'm a little nervous."
    },
    {
      "start_ms": 24300,
      "end_ms": 29820,
      "text": "Don't worry, we've got something for you. Look!"
    },
    {
      "start_ms": 30800,
      "end_ms": 32360,
      "text": "A paper boat?"
    },
    {
      "start_ms": 33500,
      "end_ms": 38260,
      "text": "Yes, and it's also a letter from Mum and me."
    },
    {
      "start_ms": 39320,
      "end_ms": 41600,
      "text": "We want to share some thoughts with you."
    },
    {
      "start_ms": 42180,
      "end_ms": 44400,
      "text": "Oh, thank you!"
    },
    {
      "start_ms": 46100,
      "end_ms": 48920,
      "text": "Dear Mia, time flies."
    },
    {
      "start_ms": 50260,
      "end_ms": 52080,
      "text": "You are now in junior high."
    },
    {
      "start_ms": 52080,
      "end_ms": 58500,
      "text": "Are you ready for your new life? Primary school is like a small pool."
    },
    {
      "start_ms": 59380,
      "end_ms": 64580,
      "text": "Your boat is safe there. Dad and mum can protect it from winds."
    },
    {
      "start_ms": 65440,
      "end_ms": 72300,
      "text": "But junior high is like a river. It is wide and the water moves fast."
    },
    {
      "start_ms": 73800,
      "end_ms": 78020,
      "text": "You will face new problems. We are still here to help."
    },
    {
      "start_ms": 78020,
      "end_ms": 82540,
      "text": "But sometimes you have to sail your boat by yourself."
    },
    {
      "start_ms": 83340,
      "end_ms": 86320,
      "text": "Just try your best and work hard."
    },
    {
      "start_ms": 87240,
      "end_ms": 90120,
      "text": "You will go through storms towards the sea."
    },
    {
      "start_ms": 91380,
      "end_ms": 94420,
      "text": "We hope this letter helps you in the coming years."
    },
    {
      "start_ms": 95360,
      "end_ms": 98120,
      "text": "With love, dad and mum."
    }
  ],
