  "segments": [
    {
      "start_ms": 0,
      "end_ms": 4140,
      "text": "Activity 8 Work in pairs."
    },
    {
      "start_ms": 4620,
      "end_ms": 14520,
      "text": "Write about your hobby. Use the words and expressions from the reading passage and the useful expressions to help you."
    },
    {
      "start_ms": 15420,
      "end_ms": 20620,
      "text": "Then talk with your partner and take notes of his or her hobby."
    },
    {
      "start_ms": 22180,
      "end_ms": 23640,
      "text": "Example conversation"
    },
    {
      "start_ms": 25600,
      "end_ms": 27280,
      "text": "What's your hobby?"
    },
    {
      "start_ms": 27280,
      "end_ms": 29940,
      "text": "I like taking photos."
    },
    {
      "start_ms": 30940,
      "end_ms": 32700,
      "text": "Why do you like it?"
    },
    {
      "start_ms": 33460,
      "end_ms": 35460,
      "text": "Because it's so much fun."
    },
    {
      "start_ms": 36360,
      "end_ms": 39220,
      "text": "I have many friends with the same hobby."
    },
    {
      "start_ms": 40120,
      "end_ms": 43840,
      "text": "We go to different places and take photos together."
    },
    {
      "start_ms": 44760,
      "end_ms": 47140,
      "text": "It feels great to share our photos."
    }
  ],
