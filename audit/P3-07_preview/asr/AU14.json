  "segments": [
    {
      "start_ms": 0,
      "end_ms": 3300,
      "text": "Unit 2 More than fun"
    },
    {
      "start_ms": 4440,
      "end_ms": 6040,
      "text": "Understanding ideas"
    },
    {
      "start_ms": 7000,
      "end_ms": 12160,
      "text": "Activity to Look at the title and the pictures"
    },
    {
      "start_ms": 13760,
      "end_ms": 15280,
      "text": "What is the passage about?"
    },
    {
      "start_ms": 16740,
      "end_ms": 20460,
      "text": "Now read the passage and check your answer."
    },
    {
      "start_ms": 22040,
      "end_ms": 24880,
      "text": "Rock music meets the əhū"
    },
    {
      "start_ms": 26480,
      "end_ms": 36060,
      "text": "Rock music is coming out of my computer. As a rock music lover, I play the electric guitar in the school band."
    },
    {
      "start_ms": 37100,
      "end_ms": 43860,
      "text": "Sometimes I write songs and share them online. There is so much fun in music."
    },
    {
      "start_ms": 43860,
      "end_ms": 48920,
      "text": "Music Right at this moment, the sound of Grandpa's"
    },
    {
      "start_ms": 48920,
      "end_ms": 57900,
      "text": "Ah-Hoo cuts in. Yes, music is also my Grandpa's hobby. But it's a different kind of music."
    },
    {
      "start_ms": 58900,
      "end_ms": 66740,
      "text": "He likes playing the Ah-Hoo in the park with his friends. They sing Beijing opera together."
    },
    {
      "start_ms": 66740,
      "end_ms": 75960,
      "text": "there are many fans of them. An idea suddenly hits me. Why don't we put our music together?"
    },
    {
      "start_ms": 76840,
      "end_ms": 85620,
      "text": "I can write a song for us. Grandpa! I rush into his room. There is an art festival every"
    },
    {
      "start_ms": 85620,
      "end_ms": 93940,
      "text": "autumn in my school. I decide to take part in it with grandpa this year. After a week's practice,"
    },
    {
      "start_ms": 93940,
      "end_ms": 101520,
      "text": "we are on the stage. I nod to grandpa and we fire up our instruments. Everybody"
    },
    {
      "start_ms": 101520,
      "end_ms": 111040,
      "text": "moves with our music. Grandpa gives me a big smile and I smile back. It feels great"
    },
    {
      "start_ms": 111040,
      "end_ms": 113000,
      "text": "to enjoy our hobby together."
    }
  ],
