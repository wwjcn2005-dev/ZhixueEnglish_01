 "triggers": [
  {
   "name": "trg_ai_question_active_requires_human_approval",
   "table": "ai_question",
   "timing": null,
   "event": null,
   "sql": "CREATE TRIGGER trg_ai_question_active_requires_human_approval\n    BEFORE UPDATE OF lifecycle_status ON ai_question\n    WHEN NEW.lifecycle_status = 'ACTIVE'\n     AND NOT EXISTS (\n       SELECT 1 FROM question_event e\n        WHERE e.question_id = NEW.question_id\n          AND e.version = NEW.version\n          AND e.event_type = 'REVIEW_APPROVED'\n          AND e.actor_kind = 'human'\n     )\n    BEGIN\n      SELECT RAISE(ABORT, 'ACTIVE requires a human REVIEW_APPROVED event');\n    END"
  },
  {
   "name": "trg_ai_question_insert_active_forbidden",
   "table": "ai_question",
   "timing": null,
   "event": null,
   "sql": "CREATE TRIGGER trg_ai_question_insert_active_forbidden\n    BEFORE INSERT ON ai_question\n    WHEN NEW.lifecycle_status = 'ACTIVE'\n    BEGIN\n      SELECT RAISE(ABORT, 'validator PASS is not enough: a question cannot be inserted as ACTIVE');\n    END"
  },
  {
   "name": "trg_ai_question_no_delete",
   "table": "ai_question",
   "timing": null,
   "event": null,
   "sql": "CREATE TRIGGER trg_ai_question_no_delete\n    BEFORE DELETE ON ai_question\n    BEGIN\n      SELECT RAISE(ABORT, 'ai_question rows may not be deleted; use DISABLED instead');\n    END"
  },
  {
   "name": "trg_question_event_no_delete",
   "table": "question_event",
   "timing": null,
   "event": null,
   "sql": "CREATE TRIGGER trg_question_event_no_delete\n    BEFORE DELETE ON question_event\n    BEGIN\n      SELECT RAISE(ABORT, 'question_event is append-only: DELETE is forbidden');\n    END"
  },
  {
   "name": "trg_question_event_no_update",
   "table": "question_event",
   "timing": null,
   "event": null,
