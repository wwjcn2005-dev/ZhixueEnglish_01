  {
   "block_id": "FLTRP-EN-7A-2022CUR:P28:B13",
   "kind": "sidebar_tip",
   "role": "sidebar",
   "text": "B"
  },
  {
   "block_id": "FLTRP-EN-7A-2022CUR:P28:B6",
   "kind": "exercise_item",
   "role": "body",
   "text": "It takes one month to finish a book report. It’s hard to finish it on time."
