 "problem_A_exact_rule": {
  "old_condition": "answer_support_type='EXACT' AND 答案文本出现在 question_text 或 options",
  "new_condition": "answer_support_type='EXACT' AND 题目可选型（有 options） AND 正确答案文本出现在教材 evidence_quote 中",
  "applied_to": "question_library.db 触发器 trg_validation_exact_trap",
  "python_semantics": "validator_v3.exact_print_risk()",
  "trigger_sql": "CREATE TRIGGER trg_validation_exact_trap\n    AFTER INSERT ON question_validation\n    WHEN NEW.answer_support_type = 'EXACT'\n     AND EXISTS (\n       SELECT 1\n         FROM ai_question q\n         JOIN question_evidence e\n           ON e.question_id = q.question_id AND e.version = q.version\n        WHERE q.question_id = NEW.question_id\n          AND q.version = NEW.version\n          AND q.options_json IS NOT NULL\n          AND instr(lower(replace(replace(replace(replace(e.evidence_quote, char(8220), '\"'), char(8221), '\"'), char(8217), char(39)), char(8216), char(39))), lower(q.correct_answer)) > 0\n     )\n    BEGIN\n      UPDATE question_validation\n         SET needs_human_review = 1\n       WHERE question_id = NEW.question_id\n         AND version = NEW.version\n         AND validator_version = NEW.validator_version;\n      UPDATE ai_question\n         SET needs_human_review = 1,\n             updated_at = NEW.validated_at\n       WHERE question_id = NEW.question_id\n         AND version = NEW.version;\n    END"
 },
