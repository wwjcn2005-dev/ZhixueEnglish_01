  "segments": [
    {
      "start_ms": 0,
      "end_ms": 1300,
      "text": "Unit 4"
    },
    {
      "start_ms": 2000,
      "end_ms": 3480,
      "text": "Time to celebrate"
    },
    {
      "start_ms": 5000,
      "end_ms": 6780,
      "text": "Understanding ideas"
    },
    {
      "start_ms": 8000,
      "end_ms": 9300,
      "text": "Activity to"
    },
    {
      "start_ms": 10000,
      "end_ms": 11700,
      "text": "Read the passage"
    },
    {
      "start_ms": 11700,
      "end_ms": 16280,
      "text": "What does the writer do during the spring festival?"
    },
    {
      "start_ms": 17880,
      "end_ms": 20720,
      "text": "An unusual spring festival."
    },
    {
      "start_ms": 21680,
      "end_ms": 25960,
      "text": "It is my first year of university in the UK."
    },
    {
      "start_ms": 25960,
      "end_ms": 34540,
      "text": "My English friend Amelia is a nice girl. Sometimes she cooks British food for me."
    },
    {
      "start_ms": 35440,
      "end_ms": 42300,
      "text": "Today is the spring festival, so I want to treat her to a Chinese dinner."
    },
    {
      "start_ms": 43240,
      "end_ms": 50640,
      "text": "At home I often watch Grandma cook. I never realised cooking was so difficult."
    },
    {
      "start_ms": 50640,
      "end_ms": 54800,
      "text": "How I wish to have four hands now!"
    },
    {
      "start_ms": 56140,
      "end_ms": 60220,
      "text": "It is midnight in China. Time for dumplings!"
    },
    {
      "start_ms": 61360,
      "end_ms": 64560,
      "text": "My whole family come to help me on the phone."
    },
    {
      "start_ms": 65500,
      "end_ms": 67840,
      "text": "Step by step they teach me."
    },
    {
      "start_ms": 68760,
      "end_ms": 71240,
      "text": "I even make some cucumber flowers."
    },
    {
      "start_ms": 73160,
      "end_ms": 76760,
      "text": "After Amelia hangs balloons and lanterns in the dining room,"
    },
    {
      "start_ms": 76760,
      "end_ms": 79640,
      "text": "I put the last dish on the table."
    },
    {
      "start_ms": 80940,
      "end_ms": 82880,
      "text": "This is the lion's head."
    },
    {
      "start_ms": 83600,
      "end_ms": 84840,
      "text": "Are you joking?"
    },
    {
      "start_ms": 85960,
      "end_ms": 87680,
      "text": "Isn't that against the law?"
    },
    {
      "start_ms": 88620,
      "end_ms": 90140,
      "text": "Amelia is shocked."
    },
    {
      "start_ms": 91060,
      "end_ms": 91780,
      "text": "I laugh."
    },
    {
      "start_ms": 93000,
      "end_ms": 94760,
      "text": "It's a pork meatball."
    },
    {
      "start_ms": 95520,
      "end_ms": 98780,
      "text": "My family always have it at the Spring Festival."
    },
    {
      "start_ms": 99840,
      "end_ms": 103400,
      "text": "Its round shape stands for family reunions."
    },
    {
      "start_ms": 104020,
      "end_ms": 104820,
      "text": "Try it."
    },
    {
      "start_ms": 105960,
      "end_ms": 111360,
      "text": "Amelia cuts a piece of it with her knife and puts it into her mouth."
    },
    {
      "start_ms": 112220,
      "end_ms": 115680,
      "text": "Mmm, I love it! She says,"
    },
    {
      "start_ms": 116080,
      "end_ms": 121800,
      "text": "The smell of the dishes and the sound of our laughing fill the room."
    },
    {
      "start_ms": 122640,
      "end_ms": 125200,
      "text": "I feel like I am back home."
    }
  ],
