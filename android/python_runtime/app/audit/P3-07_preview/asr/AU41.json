  "segments": [
    {
      "start_ms": 0,
      "end_ms": 3720,
      "text": "Reading for writing. Activity to"
    },
    {
      "start_ms": 5000,
      "end_ms": 12380,
      "text": "Read the passage. Find out the importance of tea to the Chinese and the Brits."
    },
    {
      "start_ms": 14040,
      "end_ms": 24660,
      "text": "What's your cup of tea? What is the most popular drink in the world after water? The answer is tea."
    },
    {
      "start_ms": 24660,
      "end_ms": 31880,
      "text": "It is not only good for our health but also a key part of many cultures."
    },
    {
      "start_ms": 33460,
      "end_ms": 35660,
      "text": "What does tea mean to you?"
    },
    {
      "start_ms": 38260,
      "end_ms": 38960,
      "text": "Feng Tao"
    },
    {
      "start_ms": 40260,
      "end_ms": 46360,
      "text": "In Chengdu we have as many tea houses as leaves in a cup of tea."
    },
    {
      "start_ms": 47200,
      "end_ms": 50420,
      "text": "Grandpa used to take me to the tea house."
    },
    {
      "start_ms": 50420,
      "end_ms": 55380,
      "text": "He and his friends drank tea and shared their news."
    },
    {
      "start_ms": 56360,
      "end_ms": 58420,
      "text": "Now I study abroad."
    },
    {
      "start_ms": 59440,
      "end_ms": 65800,
      "text": "Most of my classmates prefer coffee, but I will always choose green tea."
    },
    {
      "start_ms": 66700,
      "end_ms": 68680,
      "text": "It's more than a drink for me."
    },
    {
      "start_ms": 69340,
      "end_ms": 74360,
      "text": "A cup of warm tea always makes me feel like I'm back home."
    },
    {
      "start_ms": 76220,
      "end_ms": 76860,
      "text": "Emma Jones"
    },
    {
      "start_ms": 77740,
      "end_ms": 86260,
      "text": "It's no secret that Brits love afternoon tea, but actually we drink tea all day."
    },
    {
      "start_ms": 87160,
      "end_ms": 90460,
      "text": "My husband can drink eight cups a day."
    },
    {
      "start_ms": 91340,
      "end_ms": 96380,
      "text": "When my kids were young, I always made tea for them after school."
    },
    {
      "start_ms": 97380,
      "end_ms": 101440,
      "text": "Now they're adults, but they come back every weekend."
    },
    {
      "start_ms": 101440,
      "end_ms": 106640,
      "text": "We chat and relax in the yard with black tea and biscuits."
    },
    {
      "start_ms": 107440,
      "end_ms": 109620,
      "text": "It's our way of connecting."
    }
  ],
