  "segments": [
    {
      "start_ms": 0,
      "end_ms": 3400,
      "text": "Unit 3. Family Ties"
    },
    {
      "start_ms": 4720,
      "end_ms": 6960,
      "text": "Understanding Ideas"
    },
    {
      "start_ms": 8000,
      "end_ms": 9440,
      "text": "Activity too"
    },
    {
      "start_ms": 11000,
      "end_ms": 17660,
      "text": "Read the film review. What is the father's love like according to the writer?"
    },
    {
      "start_ms": 19560,
      "end_ms": 21020,
      "text": "Silent Love"
    },
    {
      "start_ms": 23000,
      "end_ms": 27420,
      "text": "Along a mountain road, a handsome young man walks fast."
    },
    {
      "start_ms": 27420,
      "end_ms": 35920,
      "text": "An older man with a strict face follows him. This is from my favourite film, Postman in"
    },
    {
      "start_ms": 35920,
      "end_ms": 43740,
      "text": "the Mountains. It's a touching story about the love between father and son. For years,"
    },
    {
      "start_ms": 44240,
      "end_ms": 49620,
      "text": "the father served as the postman for this area. He was often absent from home,"
    },
    {
      "start_ms": 50060,
      "end_ms": 56000,
      "text": "and the son seldom saw him. But now the son is taking over his father's position."
    },
    {
      "start_ms": 56780,
      "end_ms": 64380,
      "text": "The father goes with him on his first day of work. Along the way, they start to see into each"
    },
    {
      "start_ms": 64380,
      "end_ms": 73560,
      "text": "other's hearts. For the first time, the son carries his father across a cold river. It brings back"
    },
    {
      "start_ms": 73560,
      "end_ms": 80620,
      "text": "the father's memory of carrying the son on his back. Tears quietly run down his face."
    },
    {
      "start_ms": 81720,
      "end_ms": 88720,
      "text": "This film shows a traditional Chinese father. He is happy about his son's growth,"
    },
    {
      "start_ms": 89280,
      "end_ms": 95860,
      "text": "but he just hides his care in his heart. He doesn't give hugs or kisses to his son."
    },
    {
      "start_ms": 97060,
      "end_ms": 102160,
      "text": "His love may be silent, but like a mountain, it is always there."
    }
  ],
