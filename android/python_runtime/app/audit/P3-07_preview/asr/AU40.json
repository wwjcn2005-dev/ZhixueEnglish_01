    },
    {
      "start_ms": 38040,
      "end_ms": 39660,
      "text": "Oh, what's that?"
    },
    {
      "start_ms": 40760,
      "end_ms": 42780,
      "text": "It's corn silk tea."
    },
    {
      "start_ms": 43660,
      "end_ms": 44720,
      "text": "Corn silk?"
    },
    {
      "start_ms": 45520,
      "end_ms": 47920,
      "text": "It's the hair of corn."
    },
    {
      "start_ms": 49000,
      "end_ms": 52420,
