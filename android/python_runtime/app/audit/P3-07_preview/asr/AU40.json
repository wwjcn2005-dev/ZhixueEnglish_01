    {
      "start_ms": 7840,
      "end_ms": 10240,
      "text": "Can I try the taco?"
    },
    {
      "start_ms": 11200,
      "end_ms": 11720,
      "text": "Sure."
    },
    {
      "start_ms": 12560,
      "end_ms": 18040,
      "text": "Mmm, yum! Are tacos a traditional Mexican food?"
    },
    {
      "start_ms": 18800,
      "end_ms": 22540,
      "text": "They are. We make them from corn seeds."
    },
    {
      "start_ms": 23500,
      "end_ms": 25460,
      "text": "Is this beef inside?"
    },
    {
      "start_ms": 25460,
      "end_ms": 30600,
      "text": "Yeah, you can put almost anything in a taco."
    },
    {
      "start_ms": 31540,
      "end_ms": 33600,
      "text": "Now try these chips."
    },
    {
      "start_ms": 34520,
      "end_ms": 37180,
