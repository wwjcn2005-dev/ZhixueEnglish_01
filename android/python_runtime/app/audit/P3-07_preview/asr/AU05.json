    {
      "start_ms": 8660,
      "end_ms": 11060,
      "text": "Good morning everyone!"
    },
    {
      "start_ms": 11880,
      "end_ms": 13420,
      "text": "Good morning teacher!"
    },
    {
      "start_ms": 14180,
      "end_ms": 16480,
      "text": "Welcome to junior high!"
    },
    {
      "start_ms": 17140,
      "end_ms": 20460,
      "text": "I'm Mr Pan, your English teacher."
    },
    {
      "start_ms": 21020,
      "end_ms": 23880,
      "text": "I'm so happy to meet you all."
    },
    {
      "start_ms": 23880,
      "end_ms": 33900,
      "text": "I like playing the piano, reading books and travelling and I love working with students."
    },
    {
      "start_ms": 35120,
      "end_ms": 41820,
      "text": "This year we'll explore the world of English together. It'll be a lot of fun!"
    },
    {
      "start_ms": 42900,
      "end_ms": 50420,
      "text": "Now it's your turn to introduce yourselves. Please tell us your name and your hobby."
    },
    {
      "start_ms": 50420,
      "end_ms": 52940,
      "text": "Who wants to go first?"
    }
