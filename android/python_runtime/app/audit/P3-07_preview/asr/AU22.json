  "segments": [
    {
      "start_ms": 0,
      "end_ms": 1560,
      "text": "Activity 8"
    },
    {
      "start_ms": 2580,
      "end_ms": 6500,
      "text": "Draw and write about a loving family moment."
    },
    {
      "start_ms": 7080,
      "end_ms": 9300,
      "text": "Then share it with the class."
    },
    {
      "start_ms": 10340,
      "end_ms": 13840,
      "text": "Use the words and expressions from the reading passage"
    },
    {
      "start_ms": 13840,
      "end_ms": 17260,
      "text": "and the useful expressions to help you."
    },
    {
      "start_ms": 18340,
      "end_ms": 19340,
      "text": "Example"
    },
    {
      "start_ms": 20460,
      "end_ms": 22240,
      "text": "Hi everyone."
    },
    {
      "start_ms": 23060,
      "end_ms": 24740,
      "text": "Look at my picture."
    },
    {
      "start_ms": 24740,
      "end_ms": 30580,
      "text": "It is about a loving moment between my grandma and me."
    },
    {
      "start_ms": 31680,
      "end_ms": 37260,
      "text": "Look! This is me. This is grandma."
    },
    {
      "start_ms": 38900,
      "end_ms": 42160,
      "text": "We are at grandma's house in the countryside."
    },
    {
      "start_ms": 43500,
      "end_ms": 51100,
      "text": "Grandma makes a heart with corn on the ground and birds come to eat it."
    },
    {
      "start_ms": 51100,
      "end_ms": 54060,
      "text": "They make a heart for me."
    },
    {
      "start_ms": 55540,
      "end_ms": 60320,
      "text": "The photo brings back my memory of the wonderful moment."
    },
    {
      "start_ms": 61140,
      "end_ms": 63060,
      "text": "I'm happy about it."
    }
  ],
