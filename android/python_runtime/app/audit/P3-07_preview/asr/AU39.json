  "segments": [
    {
      "start_ms": 0,
      "end_ms": 7380,
      "text": "Activity 2 Listen again and complete Jason's notes for the"
    },
    {
      "start_ms": 7380,
      "end_ms": 7780,
      "text": "vlog."
    },
    {
      "start_ms": 10320,
      "end_ms": 20980,
      "text": "Welcome to Amazing Plants. This is Jason. I'm at the Sweet Corn Festival in Mexico. Look"
    },
    {
      "start_ms": 20980,
      "end_ms": 30480,
      "text": "at this ear of corn. Can you believe the size of it? But it's not the biggest. The biggest"
    },
    {
      "start_ms": 30480,
      "end_ms": 39780,
      "text": "one is nearly 40 centimetres long. People started growing corn in Mexico about"
    },
    {
      "start_ms": 39780,
      "end_ms": 49660,
      "text": "9,000 years ago. Today it's a big part of their cooking. There are over 600 corn dishes"
    },
    {
      "start_ms": 51400,
      "end_ms": 61580,
      "text": "Corn isn't just food. People even use it to make toys. It's also part of Mexican culture."
    },
    {
      "start_ms": 62520,
      "end_ms": 64060,
      "text": "Let's go and see!"
    }
  ],
