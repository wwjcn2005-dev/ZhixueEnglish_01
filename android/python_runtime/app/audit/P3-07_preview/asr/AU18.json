  "segments": [
    {
      "start_ms": 0,
      "end_ms": 1880,
      "text": "Activity 2"
    },
    {
      "start_ms": 3000,
      "end_ms": 5980,
      "text": "Listen again and order the pictures."
    },
    {
      "start_ms": 8000,
      "end_ms": 12240,
      "text": "Look Wei Feng, there's a brown bird over there."
    },
    {
      "start_ms": 12860,
      "end_ms": 14820,
      "text": "Let's go closer."
    },
    {
      "start_ms": 16000,
      "end_ms": 19800,
      "text": "Oh no, it can't fly."
    },
    {
      "start_ms": 20780,
      "end_ms": 22660,
      "text": "Shall we get the teacher?"
    },
    {
      "start_ms": 23740,
      "end_ms": 26820,
      "text": "I have an idea."
    },
    {
      "start_ms": 26820,
      "end_ms": 33340,
      "text": "Wang Chen is in the bird watching club. Let's ask him."
    },
    {
      "start_ms": 34340,
      "end_ms": 36400,
      "text": "Wang Chen, help!"
    },
    {
      "start_ms": 37560,
      "end_ms": 49400,
      "text": "Let me see. Don't worry, I know this kind of bird. I can help. We just need to hold it up to the window."
    },
    {
      "start_ms": 50220,
      "end_ms": 53900,
      "text": "Wow! The bird flies away!"
    },
    {
      "start_ms": 53900,
      "end_ms": 66340,
      "text": "Wang Chen, you know so much about birds. I'm in the school news station. Can I interview you next week?"
    },
    {
      "start_ms": 67180,
      "end_ms": 67820,
      "text": "Sure."
    }
  ],
