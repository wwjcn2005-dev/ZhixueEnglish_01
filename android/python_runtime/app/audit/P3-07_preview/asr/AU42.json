  "segments": [
    {
      "start_ms": 0,
      "end_ms": 3760,
      "text": "Unit 6 Fantastic Friends"
    },
    {
      "start_ms": 5500,
      "end_ms": 6900,
      "text": "Understanding ideas"
    },
    {
      "start_ms": 8000,
      "end_ms": 9140,
      "text": "Activity too"
    },
    {
      "start_ms": 11000,
      "end_ms": 15620,
      "text": "Read the blogs and find out the words Henry used."
    },
    {
      "start_ms": 18000,
      "end_ms": 18780,
      "text": "Pigeon surprise"
    },
    {
      "start_ms": 20500,
      "end_ms": 21060,
      "text": "Day 1"
    },
    {
      "start_ms": 22500,
      "end_ms": 25760,
      "text": "We're studying birds for bird week at school."
    },
    {
      "start_ms": 25760,
      "end_ms": 32560,
      "text": "Some lucky kids got penguins, but I have to write about pigeons."
    },
    {
      "start_ms": 34140,
      "end_ms": 35440,
      "text": "Day 2"
    },
    {
      "start_ms": 36520,
      "end_ms": 45000,
      "text": "I'm watching pigeons in the park now. They just knock around for the whole morning. They leave"
    },
    {
      "start_ms": 45000,
      "end_ms": 54360,
      "text": "droppings here and there. Pigeons are boring and dirty. A girl is feeding them."
    },
    {
      "start_ms": 54360,
      "end_ms": 60380,
      "text": "The birds are flying madly to her. They're scary!"
    },
    {
      "start_ms": 62120,
      "end_ms": 62760,
      "text": "Day 3"
    },
    {
      "start_ms": 63800,
      "end_ms": 72400,
      "text": "I'm doing some online research. Pigeons can recognize themselves in mirrors. How surprising!"
    },
    {
      "start_ms": 73360,
      "end_ms": 77000,
      "text": "Are they so clever? I'd better go and watch them again."
    },
    {
      "start_ms": 78520,
      "end_ms": 79680,
      "text": "Day 4"
    },
    {
      "start_ms": 80740,
      "end_ms": 89000,
      "text": "I'm back at the park again. Oh, that pigeon is looking at itself in the water. Maybe I"
    },
    {
      "start_ms": 89000,
      "end_ms": 90260,
      "text": "was wrong about pigeons."
    },
    {
      "start_ms": 92420,
      "end_ms": 93140,
      "text": "Day 5"
    },
    {
      "start_ms": 94840,
      "end_ms": 104280,
      "text": "I'm reading in the library now. Oh, there are over 200 kinds of pigeons. Some can fly"
    },
    {
      "start_ms": 104280,
      "end_ms": 111860,
      "text": "several thousand kilometers and don't get lost. They can also fly at speeds of"
    },
    {
      "start_ms": 111860,
      "end_ms": 121480,
      "text": "over 100 kilometers per hour. That's as fast as my dad's car. Well, pigeons aren't"
    },
    {
      "start_ms": 121480,
      "end_ms": 128320,
      "text": "boring or scary. They are amazing. I just didn't know enough about them."
    }
  ],
