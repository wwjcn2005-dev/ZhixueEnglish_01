  "segments": [
    {
      "start_ms": 0,
      "end_ms": 4040,
      "text": "Developing ideas. Activity 1"
    },
    {
      "start_ms": 5000,
      "end_ms": 10940,
      "text": "Listen to the opening of the vlog. What is Jason talking about?"
    },
    {
      "start_ms": 12480,
      "end_ms": 22320,
      "text": "Welcome to Amazing Plants. This is Jason. I'm at the Sweet Corn Festival in Mexico."
    },
    {
      "start_ms": 22320,
      "end_ms": 31840,
      "text": "Mexico. Look at this ear of corn. Can you believe the size of it? But it's not the biggest."
    },
    {
      "start_ms": 32680,
      "end_ms": 42780,
      "text": "The biggest one is nearly 40 centimetres long. People started growing corn in Mexico about"
    },
    {
      "start_ms": 42780,
      "end_ms": 52260,
      "text": "9,000 years ago. Today it's a big part of their cooking. There are over 600 corn"
    },
    {
      "start_ms": 52260,
      "end_ms": 62960,
      "text": "dishes now. Corn isn't just food. People even use it to make toys. It's also part"
    },
    {
      "start_ms": 62960,
      "end_ms": 67060,
      "text": "of Mexican culture. Let's go and see!"
    }
  ],
