  "segments": [
    {
      "start_ms": 0,
      "end_ms": 4260,
      "text": "Activity 8 Work in pairs"
    },
    {
      "start_ms": 5000,
      "end_ms": 11980,
      "text": "Talk about a teacher you like. Use the thinking map to organise your ideas."
    },
    {
      "start_ms": 12740,
      "end_ms": 19980,
      "text": "Use the words and expressions from the reading passage and the useful expressions to help you."
    },
    {
      "start_ms": 21120,
      "end_ms": 22720,
      "text": "Example conversation"
    },
    {
      "start_ms": 24400,
      "end_ms": 29720,
      "text": "Mr Lee is our history teacher. He is great."
    },
    {
      "start_ms": 30720,
      "end_ms": 32720,
      "text": "Why do you think so?"
    },
    {
      "start_ms": 33540,
      "end_ms": 40640,
      "text": "He is very different. He wants us to ask questions about history in class."
    },
    {
      "start_ms": 41720,
      "end_ms": 48840,
      "text": "He can answer all kinds of questions and this makes the class so fun."
    },
    {
      "start_ms": 48840,
      "end_ms": 52220,
      "text": "Do you like his way of teaching?"
    },
    {
      "start_ms": 53080,
      "end_ms": 63840,
      "text": "Yes, of course. He tells us we need to ask good questions. We need to think hard to ask"
    },
    {
      "start_ms": 63840,
      "end_ms": 68200,
      "text": "good questions. It's a great way to learn."
    }
  ],
