  "segments": [
    {
      "start_ms": 0,
      "end_ms": 1720,
      "text": "Know your school"
    },
    {
      "start_ms": 3000,
      "end_ms": 3960,
      "text": "Activity 1"
    },
    {
      "start_ms": 4840,
      "end_ms": 6580,
      "text": "Read and complete"
    },
    {
      "start_ms": 9040,
      "end_ms": 9400,
      "text": "Welcome"
    },
    {
      "start_ms": 11320,
      "end_ms": 13860,
      "text": "This is your new school"
    },
    {
      "start_ms": 14640,
      "end_ms": 18400,
      "text": "There are three buildings and a playground"
    },
    {
      "start_ms": 19440,
      "end_ms": 23380,
      "text": "It's not big, but it is beautiful"
    },
    {
      "start_ms": 24520,
      "end_ms": 27460,
      "text": "Let's go around the school together"
    },
    {
      "start_ms": 28940,
      "end_ms": 38640,
      "text": "This is the teaching building. It has three floors. There are 30 classrooms on the first"
    },
    {
      "start_ms": 38640,
      "end_ms": 47140,
      "text": "and second floors. And there are 10 science labs and eight computer labs on the third"
    },
    {
      "start_ms": 47140,
      "end_ms": 47560,
      "text": "floor."
    },
    {
      "start_ms": 49120,
      "end_ms": 60200,
      "text": "This is our library. It has got many books. There are also reading rooms. We can read and study here."
    },
    {
      "start_ms": 61680,
      "end_ms": 74280,
      "text": "This is our playground. We do morning exercises here. After school we come to run or play football here."
    },
    {
      "start_ms": 75720,
      "end_ms": 82480,
      "text": "This is our dining hall. It's not big but the food is good."
    }
  ],
