      "text": "Activity 2"
    },
    {
      "start_ms": 2000,
      "end_ms": 7060,
      "text": "Listen again and complete the webpage for Bingjia."
    },
    {
      "start_ms": 8640,
      "end_ms": 11520,
      "text": "Welcome to Animal Stars."
    },
    {
      "start_ms": 12500,
      "end_ms": 17200,
      "text": "Today's Animal Star is a special dog, Bingjia."
    },
    {
      "start_ms": 18060,
      "end_ms": 22140,
      "text": "He was a rescue dog and worked with firemen."
    },
    {
      "start_ms": 23180,
      "end_ms": 26600,
      "text": "Bingjia had a good sense of smell."
    },
    {
      "start_ms": 26600,
      "end_ms": 32640,
      "text": "He worked after many earthquakes and helped find missing people."
    },
    {
      "start_ms": 34240,
      "end_ms": 37040,
      "text": "Over the years he saved many lives."
    },
    {
      "start_ms": 37960,
      "end_ms": 44280,
      "text": "His most famous rescue took place after the 2008 Wenchuan earthquake."
    },
    {
      "start_ms": 45120,
      "end_ms": 48080,
      "text": "He helped to find 13 people."
    },
    {
      "start_ms": 49340,
      "end_ms": 58820,
      "text": "Binhjia died on 2 October 2021 at the age of 14. He was a hero."
    }
  ],
