  "segments": [
    {
      "start_ms": 0,
      "end_ms": 3240,
      "text": "Unit 1 A New Start"
    },
    {
      "start_ms": 4560,
      "end_ms": 6640,
      "text": "Understanding Ideas"
    },
    {
      "start_ms": 7280,
      "end_ms": 10940,
      "text": "Activity 2 Read the passage"
    },
    {
      "start_ms": 11920,
      "end_ms": 15340,
      "text": "What does the writer do in his first lesson?"
    },
    {
      "start_ms": 16800,
      "end_ms": 18920,
      "text": "The first lesson"
    },
    {
      "start_ms": 20480,
      "end_ms": 28060,
      "text": "Our English teacher, Ms Chen, writes the sentence on the blackboard and says"
    },
    {
      "start_ms": 28060,
      "end_ms": 30680,
      "text": "Please write this down."
    },
    {
      "start_ms": 31500,
      "end_ms": 33180,
      "text": "We start to write."
    },
    {
      "start_ms": 34260,
      "end_ms": 37880,
      "text": "I write down the first word and stop."
    },
    {
      "start_ms": 39420,
      "end_ms": 40220,
      "text": "That's not right."
    },
    {
      "start_ms": 40900,
      "end_ms": 43720,
      "text": "But is it okay to point out the mistake?"
    },
    {
      "start_ms": 44700,
      "end_ms": 47280,
      "text": "Is that polite in the first lesson?"
    },
    {
      "start_ms": 48220,
      "end_ms": 50640,
      "text": "Questions jump into my mind."
    },
    {
      "start_ms": 51480,
      "end_ms": 54160,
      "text": "Why aren't you writing, Wang Han?"
    },
    {
      "start_ms": 54160,
      "end_ms": 65920,
      "text": "I look up at Ms Chen. My eyes meet hers. My mouth feels dry. But then I think about the"
    },
    {
      "start_ms": 65920,
      "end_ms": 78360,
      "text": "meaning of the sentence. I put up my hand. Ms Chen, there's a mistake, I say. That sentence is from"
    },
    {
      "start_ms": 78360,
      "end_ms": 88080,
      "text": "Confucius. Not for amentious. Well done, Wong Han. In fact, this is my first"
    },
    {
      "start_ms": 88080,
      "end_ms": 95780,
      "text": "lesson for all of you. You are now in junior high school. Learning will be more difficult."
    },
    {
      "start_ms": 96540,
      "end_ms": 102380,
      "text": "You need to think more in your learning. Please always remember this."
    },
    {
      "start_ms": 103260,
      "end_ms": 105880,
      "text": "That's really an important lesson."
    }
  ],
