    },
    {
      "start_ms": 25120,
      "end_ms": 31080,
      "text": "Tomorrow is your first day of junior high school. Are you ready?"
    },
    {
      "start_ms": 31920,
      "end_ms": 32840,
      "text": "Yes, Mum."
    },
    {
      "start_ms": 33640,
      "end_ms": 35540,
      "text": "Where is your school bag?"
    },
    {
      "start_ms": 36280,
      "end_ms": 49220,
      "text": "Here it is. And look at my pencil case. I have two pencils, three pens, an eraser and a ruler in it."
    },
    {
      "start_ms": 49840,
      "end_ms": 51340,
      "text": "And your textbooks?"
    },
    {
      "start_ms": 51340,
      "end_ms": 55000,
      "text": "books? Put them in your school bag."
    },
    {
      "start_ms": 55660,
      "end_ms": 56380,
      "text": "Okay."
    }
